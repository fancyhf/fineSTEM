# fineSTEM 香港部署 - 服务器配置清单 (.env 部署模板)
# 版本: v1.0.0 | 创建: 2026-08-23
# 用途: 部署到腾讯云香港服务器时,按此清单填写真实值。此文件不入库,仅作配置参考。

# =====================================================================
# 一、服务器信息 (腾讯云控制台查看)
# =====================================================================
# 你已购买: 腾讯云轻量 香港入门型 2核2G/20Mbps/512G, Ubuntu, 半年
SERVER_IP=你的服务器公网IP
SERVER_SSH_USER=ubuntu
SERVER_SSH_PORT=22

# =====================================================================
# 二、域名信息 (DNSPod 注册)
# =====================================================================
# 域名注册: https://dnspod.cloud.tencent.com/ 搜 wostemstudio.site
DOMAIN=wostemstudio.site
# 生产访问地址
PROD_URL=https://wostemstudio.site

# =====================================================================
# 三、后端配置 (apps/backend/.env, 部署到服务器 /opt/finestem/app)
# =====================================================================
# 后端端口规范: 部署用 8001 (见 project_rules.md §1.6)
BACKEND_PORT=8001

# CORS: 只允许生产域名
CORS_ALLOW_ORIGINS=["https://wostemstudio.site"]

# ZeroClaw Gateway (香港服务器本机)
ZEROCLAW_GATEWAY_URL=http://127.0.0.1:42617
ZEROCLAW_FALLBACK_GATEWAY_URL=
ZEROCLAW_API_KEY=
ZEROCLAW_DEFAULT_MODEL=deepseek-v4-pro
ZEROCLAW_FALLBACK_MODEL=qwen-plus
ZEROCLAW_ENABLE_MOCK_FALLBACK=False
ZEROCLAW_TIMEOUT_SECONDS=60

# 数据库 (香港服务器路径)
DATABASE_URL=sqlite:////opt/finestem/data/finestem.db

# 存储路径 (香港服务器)
STORAGE_BASE_PATH=/opt/finestem/data
STORAGE_UPLOAD_DIR=uploads
STORAGE_PACKAGES_DIR=packages
STORAGE_EXPORTS_DIR=exports
STORAGE_INDEX_FILE=file_index.json

# JWT 密钥 (生产必须改! 用 python 生成强随机)
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请填新生成的强随机密钥
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =====================================================================
# 四、AI 模型密钥（2026-08-23 统一管理后只分两层，别处不再放 key）
# =====================================================================
# 层 1 —— 后端直连调用（截图识别 GLM-4V / 封面图 CogView / 直连回退）:
#   唯一设置点 = 服务器上 apps/backend/.env，规范命名:
GLM_API_KEY=粘贴你的智谱GLM新key
DEEPSEEK_API_KEY=sk-你的deepseek-key
#   验证命令（服务器上）: cd /opt/finestem/app/apps/backend && python3 scripts/check_llm_keys.py --live
#
# 层 2 —— AI 聊天主链路（前端 WebSocket → ZeroClaw daemon）:
#   key 存 ZeroClaw config.toml（keyring 加密, 不放 .env）:
#   zeroclaw config set providers.models.deepseek.default.api_key <key>
#   zeroclaw config set providers.models.glm.default.api_key <key>   # 启用 GLM fallback 时

# =====================================================================
# 五、前端配置 (apps/frontend/.env.production)
# =====================================================================
# 生产 API 地址 (通过 nginx /api 反代, 相对路径)
VITE_API_BASE_URL=/api

# ZeroClaw WebSocket (生产走 wss://, 通过 nginx /zeroclaw/ws 反代)
VITE_ZC_URL=wostemstudio.site
VITE_ZC_TOKEN=zc_生成新的pairing_token
VITE_ZC_AGENT=assistant

# 应用信息
VITE_APP_NAME=FineSTEM
VITE_ENV=production
VITE_DEBUG=false
VITE_APP_VERSION=1.0.0

# =====================================================================
# 六、部署路径规范 (服务器 /opt 下, 遵循 D:/H: 之外的标准)
# =====================================================================
# 代码目录    : /opt/finestem/app
# 数据目录    : /opt/finestem/data
# 日志目录    : /opt/finestem/logs
# 前端静态目录 : /opt/finestem/frontend/dist
# ZeroClaw   : /opt/zeroclaw/{bin,config,data}
# systemd    : /etc/systemd/system/{zeroclaw,finestem-backend}.service
# Nginx 配置  : /etc/nginx/sites-available/finestem.conf

# =====================================================================
# 七、SSL 证书 (Let's Encrypt, 免费自动续签)
# =====================================================================
# 安装命令: sudo apt install certbot python3-certbot-nginx
# 签发命令: sudo certbot --nginx -d wostemstudio.site -d www.wostemstudio.site
# 自动续签: systemctl enable certbot.timer
SSL_EMAIL=你的邮箱(用于证书到期提醒)
